---
/**
 * PROJECT PAGE — one per Markdown file in src/content/projects/.
 *
 * The file's name becomes the URL: `riverside-tower.md` -> /work/riverside-tower/
 */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import { getProjects, getProjectNeighbours, withBase, type Project } from '../../lib/content.ts';
import { SITE, WORK_TYPE_LABELS } from '../../site.config.ts';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = Project;

const project: Props = Astro.props;
const {
  title, client, type, summary, poster, video, vimeo, vimeoRatio, ratio,
  gallery, details, services, year,
  published, durationISO, transcript, seoTitle, metaDescription,
} = project.data;

const { Content } = await render(project);
const { prev, next } = await getProjectNeighbours(project.id);

const typeLabel = WORK_TYPE_LABELS[type];

// The facts panel: the fixed fields first, then anything in `details`.
const facts: [string, string][] = [
  ['Client', client],
  ['Type', typeLabel],
  ...(year ? ([['Year', String(year)]] as [string, string][]) : []),
  ...Object.entries(details),
];

/* ---------------------------------------------------------------------------
 * Structured data.
 *
 * A crawler sees an iframe where the film is, and an iframe tells it nothing.
 * VideoObject is what makes the film itself indexable — eligible for video
 * results, the video carousel and Key Moments. Google requires `name`,
 * `thumbnailUrl` and `uploadDate`; everything else below is recommended.
 *
 * It is only emitted when there is a film AND a real upload date, because a
 * VideoObject missing a required property is worse than none at all.
 * ------------------------------------------------------------------------ */

const abs = (path: string) => new URL(withBase(path), Astro.site).href;

const videoSchema =
  vimeo && published
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: title,
        description: summary.trim(),
        thumbnailUrl: [abs(poster)],
        uploadDate: published,
        ...(durationISO ? { duration: durationISO } : {}),
        embedUrl: `https://player.vimeo.com/video/${vimeo.split('?')[0]}`,
        publisher: {
          '@type': 'Organization',
          name: SITE.name,
          logo: {
            '@type': 'ImageObject',
            url: abs('/media/instruvio-logo.png'),
          },
        },
      }
    : null;

/* Breadcrumbs mirror the URL, which already has a real hierarchy. They give
   Google the trail to print under the result instead of a bare URL. */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Work', item: abs('/work/') },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const jsonLd = [breadcrumbSchema, ...(videoSchema ? [videoSchema] : [])];

/* A transcript arrives as one string; blank lines separate paragraphs. */
const transcriptParagraphs = transcript
  ? transcript.trim().split(/\n\s*\n/).map((para) => para.replace(/\s+/g, ' ').trim())
  : [];
---

<Base
  title={seoTitle ?? title}
  description={summary}
  metaDescription={metaDescription}
  image={poster}
  imageAlt={`${title} for ${client}`}
  ogType={vimeo || video ? 'video.other' : 'website'}
  jsonLd={jsonLd}
>
  <article>
    {/* --- Lead media ------------------------------------------------ */}
    <div class="lead">
      <div class="container">
        {
          /*
           * A Vimeo film takes the lead slot when one is named; otherwise the
           * local file (or just the poster) plays there as before.
           */
          vimeo ? (
            <div class="embed" style={`--embed-ratio: ${vimeoRatio ?? '16 / 9'};`}>
              <iframe
                src={`https://player.vimeo.com/video/${vimeo}${vimeo.includes('?') ? '&' : '?'}badge=0&autopause=0&player_id=0&app_id=58479`}
                title={`${title} for ${client}`}
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              />
            </div>
          ) : (
            <MediaFrame
              image={poster}
              video={video}
              alt={`${title} for ${client}`}
              ratio={ratio}
              mode={video ? 'play' : 'still'}
              loading="eager"
            />
          )
        }
      </div>
    </div>

    {/* --- Title and facts ------------------------------------------- */}
    <div class="section">
      <div class="container">
        <div class="intro">
          <div class="intro__main">
            <p class="eyebrow">{typeLabel}</p>
            <h1>{title}</h1>
            <p class="intro__summary">{summary}</p>

            <div class="prose intro__prose">
              <Content />
            </div>

            {
              /*
               * The transcript. Collapsed, because few visitors read one, but
               * present in the HTML either way — which is the point. It gives
               * a page built around an iframe several hundred words of text
               * that genuinely match what the film says.
               */
              transcriptParagraphs.length > 0 && (
                <details class="transcript">
                  <summary>Transcript</summary>
                  <div class="transcript__body">
                    {transcriptParagraphs.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              )
            }
          </div>

          <aside class="intro__aside">
            <dl class="facts">
              {
                facts.map(([label, value]) => (
                  <div class="facts__row">
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))
              }
            </dl>

            {
              services.length > 0 && (
                <div class="services">
                  <h2 class="services__title">Services</h2>
                  <ul class="services__list">
                    {services.map((service) => (
                      <li class="pill">{service}</li>
                    ))}
                  </ul>
                </div>
              )
            }
          </aside>
        </div>
      </div>
    </div>

    {/* --- Gallery ---------------------------------------------------- */}
    {
      gallery.length > 0 && (
        <div class="section">
          <div class="container">
            <h2 class="visually-hidden">Gallery</h2>
            <div class="gallery">
              {gallery.map((item) => (
                <figure class:list={['gallery__item', `gallery__item--${item.span}`]}>
                  <MediaFrame
                    image={item.image}
                    video={item.video}
                    alt={item.alt}
                    ratio={item.span === 'wide' ? '16 / 9' : '3 / 2'}
                    mode={item.video ? 'play' : 'still'}
                  />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </div>
      )
    }

    {/* --- Previous / next -------------------------------------------- */}
    {
      (prev || next) && (
        <nav class="section pager" aria-label="More projects">
          <div class="container pager__inner">
            {prev && (
              <a class="pager__link" href={withBase(`/work/${prev.id}/`)}>
                <span class="pager__label">← Previous</span>
                <span class="pager__title">{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a class="pager__link pager__link--next" href={withBase(`/work/${next.id}/`)}>
                <span class="pager__label">Next →</span>
                <span class="pager__title">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</Base>

<style>
  /*
   * Vimeo embed box.
   *
   * This deliberately does NOT use the project's `ratio` field. That field
   * sets the shape of the CARD, where a poster image is cropped to fit —
   * something a player cannot do. A 16:9 film in a 3:2 box simply sat in a
   * letterbox with an empty band above and below it.
   *
   * 16:9 is the shape of virtually every film, so the box matches the film
   * and the card keeps its own shape. If you ever embed a square or vertical
   * film, change the value here.
   */
  .embed {
    position: relative;
    aspect-ratio: var(--embed-ratio, 16 / 9);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-sunken);
  }

  .embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lead {
    padding-top: var(--space-xl);
  }

  /* ------------------------------------------------------------ intro */

  .intro {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
  }

  /* Facts move into a sidebar once there is width for two columns. */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-3xl);
    }
  }

  .intro__summary {
    max-width: 44ch;
    margin-top: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--step-2);
    line-height: 1.4;
  }

  .intro__prose {
    margin-top: var(--space-xl);
  }

  /* ------------------------------------------------------------ facts */

  .facts {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .facts__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-size: var(--step--1);
  }

  .facts__row dt {
    color: var(--text-faint);
  }

  .facts__row dd {
    margin: 0;
    text-align: right;
  }

  .services {
    margin-top: var(--space-xl);
  }

  .services__title {
    margin-bottom: var(--space-md);
    color: var(--text-faint);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .services__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------------------------------------------------------- gallery */

  .gallery {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    /* A 'wide' item runs the full width of the gallery. */
    .gallery__item--wide {
      grid-column: 1 / -1;
    }
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__item figcaption {
    margin-top: var(--space-sm);
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  /* ------------------------------------------------------------ pager */

  .pager__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .pager__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    text-decoration: none;
  }

  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }

  .pager__label {
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .pager__title {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 600;
  }
  /* --- Transcript ----------------------------------------------------- */

  .transcript {
    margin-top: var(--space-lg);
    border-top: 1px solid var(--border);
    padding-top: var(--space-md);
  }

  .transcript summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .transcript summary:hover,
  .transcript[open] summary {
    color: var(--accent);
  }

  .transcript summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .transcript__body {
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .transcript__body p + p {
    margin-top: 0.8em;
  }
</style>

