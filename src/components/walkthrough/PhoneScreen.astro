---
/**
 * One mocked-up phone screen, drawn on a 360 × 640 portrait grid.
 *
 * Scenes live in src/lib/walkthrough/screens-pacsana.ts. An unknown key
 * renders an empty phone rather than breaking the build.
 */
import { SCREENS } from '../../lib/walkthrough/screens-pacsana.ts';

interface Props {
  name: string;
  alt: string;
  class?: string;
}

const { name, alt, class: className } = Astro.props;
const screen = SCREENS[name] ?? '';
---

<figure class:list={['phone', className]}>
  <svg viewBox="0 0 360 640" role="img" aria-label={alt} preserveAspectRatio="xMidYMid meet">
    <Fragment set:html={screen} />
  </svg>
</figure>

<style>
  .phone {
    margin: 0;
    line-height: 0;
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 65%));
  }

  .phone svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 66svh;
  }
</style>
