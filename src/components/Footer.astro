---
/**
 * Site footer: brand, navigation, contact details and social links.
 * Everything shown here is read from src/site.config.ts.
 */
import { SITE, CONTACT, SOCIAL, SHOW_SOCIAL_IN_FOOTER } from '../site.config.ts';
import { getNavItems, withBase } from '../lib/content.ts';

const navItems = await getNavItems();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href={withBase('/')}>{SITE.name}</a>
      <p class="footer__tagline">{SITE.tagline}</p>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading">Site</h2>
      <ul class="footer__list">
        {
          navItems.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Contact</h2>
      <ul class="footer__list">
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        {
          CONTACT.phone && (
            <li>
              <a href={`tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`}>{CONTACT.phone}</a>
            </li>
          )
        }
        {CONTACT.location && <li class="footer__plain">{CONTACT.location}</li>}
      </ul>
    </div>

    {
      SHOW_SOCIAL_IN_FOOTER && SOCIAL.length > 0 && (
        <div class="footer__col">
          <h2 class="footer__heading">Elsewhere</h2>
          <ul class="footer__list">
            {SOCIAL.map((item) => (
              <li>
                <a href={item.href} rel="noopener noreferrer" target="_blank">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="container footer__legal">
    <p>© {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
  }

  /* One column on a phone, two on a tablet, four on a laptop. */
  .footer__inner {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .footer__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .footer__inner {
      /* The brand block takes a wider first column. */
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .footer__logo {
    font-family: var(--font-heading);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .footer__tagline {
    max-width: 22rem;
    margin-top: var(--space-sm);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .footer__heading {
    margin-bottom: var(--space-md);
    color: var(--text-faint);
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  .footer__list a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--accent);
  }

  .footer__plain {
    color: var(--text-faint);
  }

  .footer__legal {
    margin-top: var(--space-3xl);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: var(--step--1);
  }
</style>
