---
/**
 * A project tile for the home page and the work listing.
 *
 * The whole card is clickable, but only the title is a real link — the
 * ::after trick below stretches that one link over the card. That keeps a
 * single, sensibly-named link for screen readers and keyboard users instead
 * of wrapping an entire block of text in an anchor.
 */
import MediaFrame from './MediaFrame.astro';
import { withBase, type Project } from '../lib/content.ts';
import { WORK_TYPE_LABELS } from '../site.config.ts';

interface Props {
  project: Project;
  /** 'eager' for the first couple of cards, so they load without a flash. */
  loading?: 'lazy' | 'eager';
  /** A featured card runs wider and uses larger type. */
  featured?: boolean;
  /**
   * Card image shape. Kept uniform across a grid on purpose — mixing 16:9 and
   * 3:2 thumbnails leaves the rows ragged. A project's own `ratio` frontmatter
   * still governs the large image on its own page.
   */
  ratio?: string;
}

const { project, loading = 'lazy', featured = false, ratio = '16 / 9' } = Astro.props;
const { title, client, type, summary, poster, video, vimeo } = project.data;

const typeLabel = WORK_TYPE_LABELS[type];
---

<!-- data-media-hover: hovering anywhere on the card starts its preview video. -->
<article class:list={['card', { 'card--featured': featured }]} data-type={type} data-media-hover>
  <MediaFrame
    image={poster}
    video={video}
    vimeo={vimeo}
    alt={`${title} — ${client}`}
    ratio={ratio}
    mode={video || vimeo ? 'hover' : 'still'}
    loading={loading}
    class="card__media"
  />

  <div class="card__body">
    <p class="card__meta">
      <span class="card__client">{client}</span>
      <span class="card__type">{typeLabel}</span>
    </p>

    <h3 class="card__title">
      <a href={withBase(`/work/${project.id}/`)}>{title}</a>
    </h3>

    <p class="card__summary">{summary}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    /* Isolate the stacking context so the stretched link below cannot escape
       the card and cover its neighbours. */
    isolation: isolate;
  }

  .card__media {
    transition:
      transform var(--transition),
      box-shadow var(--transition);
  }

  .card:hover .card__media {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-faint);
    font-size: var(--step--1);
  }

  .card__client {
    color: var(--text-muted);
  }

  .card__type::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: calc(var(--space-sm) - 1px);
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }

  .card__title {
    font-size: var(--step-1);
  }

  .card__title a {
    text-decoration: none;
  }

  /* Stretch the title link across the whole card. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card:hover .card__title {
    color: var(--accent);
  }

  .card__summary {
    color: var(--text-muted);
    font-size: var(--step--1);
    /* Keep every card the same height regardless of summary length. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* A featured card gets a bigger title once there is room for it. */
  @media (min-width: 56rem) {
    .card--featured .card__title {
      font-size: var(--step-2);
    }

    .card--featured .card__summary {
      font-size: var(--step-0);
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
</style>
